{
  "name": "federated-commerce-retrospective",
  "version": "1.0.0",
  "private": true,
  "description": "Federated React storefront and cart with authoritative synthetic checkout.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "build:baseline": "webpack --config webpack.config.cjs --mode production --env baseline=1",
    "start": "tsx scripts/serve.ts",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "express": "4.22.1",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "4.17.25",
    "@types/node": "22.19.15",
    "@types/react": "17.0.90",
    "@types/react-dom": "17.0.26",
    "@types/supertest": "6.0.3",
    "css-loader": "7.1.4",
    "html-webpack-plugin": "5.6.6",
    "style-loader": "4.0.0",
    "supertest": "7.2.2",
    "ts-loader": "9.5.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "webpack": "5.111.1",
    "webpack-cli": "6.0.1"
  }
}
